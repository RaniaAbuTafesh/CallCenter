# Copy these variable NAMES into Railway > your service > Variables.
# Put the real values only in Railway, never in GitHub.

# Required: your OpenAI key
OPENAI_API_KEY=sk-...

# Required on Railway: TURN relay (Railway has no UDP).
# Get username/credential from your Metered.ca dashboard (TURN Server > Credentials).
# Keep a TCP entry FIRST: the server side only uses the first TURN address in the list.
PIPECAT_ICE_SERVERS=[{"urls":"turn:global.relay.metered.ca:80?transport=tcp","username":"YOUR_USERNAME","credential":"YOUR_CREDENTIAL"},{"urls":"turns:global.relay.metered.ca:443?transport=tcp","username":"YOUR_USERNAME","credential":"YOUR_CREDENTIAL"},{"urls":"turn:global.relay.metered.ca:80","username":"YOUR_USERNAME","credential":"YOUR_CREDENTIAL"},{"urls":"turn:global.relay.metered.ca:443","username":"YOUR_USERNAME","credential":"YOUR_CREDENTIAL"},{"urls":"stun:stun.relay.metered.ca:80"}]

# Recommended: password for the page (protects your OpenAI credit). Username: raghad
DEMO_PASSWORD=choose-a-strong-password
